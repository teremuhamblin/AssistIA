# ────────────────────────────────────────────────
# AssistIA v5.2 — NPM Tactical Configuration
# Doctrine : MIL-STD-IA-5.2
# Signature : QUANTUM ERA READY
# ────────────────────────────────────────────────

# Registry GitHub Packages pour le scope @teremu
@teremu:registry=https://npm.pkg.github.com/

# Toujours utiliser HTTPS
strict-ssl=true

# Logs propres pour CI/CD Quantum ERA
loglevel=warn

# Auth token (GitHub Actions ou local)
# Local : npm login --scope=@teremu --registry=https://npm.pkg.github.com
# CI/CD : GITHUB_TOKEN injecté automatiquement
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Désactivation des audits NPM (inutile pour GitHub Packages)
audit=false

# Mode ESM propre
node-linker=default

# Optimisation pour builds rapides
prefer-offline=true

# Cache optimisé Quantum ERA
prefer-online=false
cache-min=86400

# Sécurité renforcée
fund=false
