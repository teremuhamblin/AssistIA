# ────────────────────────────────────────────────
# AssistIA v5.0 — NPM Tactical Configuration
# Doctrine : MIL-STD-IA-5.0
# Signature : TACTICAL OPS READY
# ────────────────────────────────────────────────

# Registry GitHub Packages pour le scope @teremu
@teremu:registry=https://npm.pkg.github.com/

# Toujours utiliser HTTPS
strict-ssl=true

# Format des logs (plus propre pour CI/CD)
loglevel=warn

# Auth token (GitHub Actions ou local)
# En local : npm login --scope=@teremu --registry=https://npm.pkg.github.com
# En CI/CD : GITHUB_TOKEN injecté automatiquement
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Désactivation des audits NPM (inutile pour GitHub Packages)
audit=false

# Mode ESM propre
node-linker=default

# Optimisation pour builds rapides
prefer-offline=true
