{
  "name": "@teremu/assistia",
  "version": "5.2.0",
  "description": "AssistIA — Framework militaire modulaire Quantum ERA pour opérations IA, GitOps, CI/CD et automatisation tactique.",
  "type": "module",

  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./engine.js",
    "./utils": "./utils.js"
  },

  "bin": {
    "assistia": "./assistia.js"
  },

  "files": [
    "engine.js",
    "assistia.js",
    "index.js",
    "assets/",
    "docs/",
    "scripts/",
    "LICENSE",
    "README.rst"
  ],

  "scripts": {
    "start": "node index.js",
    "assistia": "node assistia.js",
    "lint": "eslint .",
    "build": "echo 'AssistIA v5.2 — Quantum ERA build terminé'",
    "prepare": "npm run lint",
    "prepublishOnly": "npm run lint && npm run build"
  },

  "keywords": [
    "assistia",
    "quantum-era",
    "military",
    "framework",
    "automation",
    "cli",
    "gitops",
    "security",
    "teremu",
    "tactical",
    "ia-engine"
  ],

  "author": "Teremu",
  "license": "MIT",

  "repository": {
    "type": "git",
    "url": "https://github.com/Teremu/AssistIA.git"
  },

  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },

  "engines": {
    "node": ">=20"
  },

  "assistia": {
    "doctrine": "MIL-STD-IA-5.2",
    "signature": "ASSISTIA FRAMEWORK — QUANTUM ERA READY",
    "assets": "6-fold Quantum Visual System",
    "ci": "GitHub Actions Tactical Pipelines",
    "modules": "Modular IA Engine v5.2"
  }
}
